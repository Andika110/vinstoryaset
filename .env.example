# Application
PORT=5173
HOST=127.0.0.1
# Harus sama dengan origin yang dipakai browser (domain tunnel di production).
ORIGIN=http://localhost:5173

# PostgreSQL native service (FND-07)
# Runtime memakai role aplikasi yang haknya terbatas.
DATABASE_URL=postgres://inventory_app:change-me@127.0.0.1:5432/inventory

# Migrasi memakai role owner database.
DATABASE_URL_MIGRATE=postgres://inventory_owner:change-me@127.0.0.1:5432/inventory

# Session signing/secret material (generate a random 32+ byte value)
SESSION_SECRET=replace-with-a-random-32-byte-secret

# Local file storage for asset photos and import files
UPLOAD_DIR=./data/uploads

# Structured logs (FND-13)
LOG_DIR=./data/logs
LOG_LEVEL=info
LOG_MAX_BYTES=5242880
LOG_MAX_FILES=5

# Seed admin pertama (FND-08)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.local
SEED_ADMIN_NAME=IT Administrator
SEED_ADMIN_PASSWORD=change-me-min-8-chars

# Opsional: outlet dan akun outlet untuk development
SEED_SAMPLE_DATA=false
SEED_OUTLET_USERNAME=outlet
SEED_OUTLET_EMAIL=outlet@example.local
SEED_OUTLET_NAME=Outlet Management Demo
SEED_OUTLET_PASSWORD=change-me-min-8-chars
